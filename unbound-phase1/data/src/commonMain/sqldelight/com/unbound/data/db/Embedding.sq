-- Reserved for Phase 4 so it never needs a risky migration on a big user database.
-- Vectors are stored as little-endian float32 (or int8) BLOBs and loaded into an in-memory
-- matrix for cosine search (brute force is milliseconds for 50k tracks).
CREATE TABLE track_embedding (
  track_id INTEGER NOT NULL REFERENCES track(id) ON DELETE CASCADE,
  model_id TEXT NOT NULL,                 -- e.g. 'clap-htsat-int8-v1'
  dims INTEGER NOT NULL,
  vector BLOB NOT NULL,
  source_fingerprint TEXT,                -- track.fingerprint when computed => recompute if the file changed
  computed_at INTEGER NOT NULL,
  PRIMARY KEY (track_id, model_id)
);

-- Acoustic X-Ray: cached separated stems per track.
CREATE TABLE stem_cache (
  track_id INTEGER NOT NULL REFERENCES track(id) ON DELETE CASCADE,
  model_id TEXT NOT NULL,
  status TEXT NOT NULL,                   -- PENDING | READY | FAILED
  dir_path TEXT,
  computed_at INTEGER,
  PRIMARY KEY (track_id, model_id)
);

upsertEmbedding:
INSERT OR REPLACE INTO track_embedding(track_id, model_id, dims, vector, source_fingerprint, computed_at)
VALUES (:trackId, :modelId, :dims, :vector, :fingerprint, :now);

embeddingsForModel:
SELECT track_id, dims, vector FROM track_embedding WHERE model_id = :modelId;

tracksMissingEmbedding:
SELECT t.id, t.uri FROM track t
LEFT JOIN track_embedding e ON e.track_id = t.id AND e.model_id = :modelId AND e.source_fingerprint IS t.fingerprint
WHERE t.is_missing = 0 AND e.track_id IS NULL;
