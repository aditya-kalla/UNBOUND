-- ============================================================================
-- Sonic Journal ledger. APPEND-ONLY. Store FACTS, never interpretations:
-- what counts as a "play" or a "skip" is decided by the `listen` view below, so the
-- thresholds can change later without rewriting history.
--
-- One listen = one START row + (normally) one END row sharing listen_id. If the app
-- is killed, START has no END; the view keeps it (listened_ms NULL, counted = 0).
-- ts is UTC epoch ms. tz_offset_min is the device's UTC offset AT THAT MOMENT, so
-- "your 2 AM tracks" stays correct after travelling or DST changes.
-- ============================================================================
CREATE TABLE playback_event (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  ts INTEGER NOT NULL,
  tz_offset_min INTEGER NOT NULL DEFAULT 0,
  event_type TEXT NOT NULL,               -- START | END | SEEK
  listen_id TEXT NOT NULL,
  track_id INTEGER,                       -- no FK on purpose: history outlives the track row
  duration_ms INTEGER NOT NULL DEFAULT 0,
  position_ms INTEGER NOT NULL DEFAULT 0, -- START: start pos; END: end pos; SEEK: from
  seek_to_ms INTEGER,                     -- SEEK only
  listened_ms INTEGER,                    -- END only: media time actually played (seeks excluded)
  start_reason TEXT,                      -- START: USER | AUTO_NEXT | AUTOPLAY | QUEUE | RESUME_APP | PREVIOUS
  end_reason TEXT,                        -- END: COMPLETED | SKIP_NEXT | SKIP_PREV | USER_STOP | REPLACED | APP_CLOSED | ERROR
  context_type TEXT,                      -- ALBUM | PLAYLIST | ARTIST | LIBRARY | LIKED | SEARCH | VIBE_SEARCH | AUTOPLAY | QUEUE
  context_id TEXT,
  output_device_type TEXT,                -- SPEAKER | WIRED | BLUETOOTH | USB_DAC | CAR | HDMI | UNKNOWN
  output_device_name TEXT,
  shuffle INTEGER NOT NULL DEFAULT 0,
  repeat_mode TEXT NOT NULL DEFAULT 'OFF',
  speed REAL NOT NULL DEFAULT 1.0
);
CREATE INDEX playback_event_ts ON playback_event(ts);
CREATE INDEX playback_event_listen ON playback_event(listen_id);
CREATE INDEX playback_event_track ON playback_event(track_id, ts);

-- One row per listen. counted = Spotify-style "stream": >= 30 s or >= half the track.
-- skipped = ended by next/prev before 30 s.
CREATE VIEW listen AS
SELECT
  s.listen_id AS listen_id,
  s.track_id AS track_id,
  s.ts AS started_at,
  s.tz_offset_min AS tz_offset_min,
  s.start_reason AS start_reason,
  s.context_type AS context_type,
  s.context_id AS context_id,
  s.output_device_type AS output_device_type,
  s.output_device_name AS output_device_name,
  s.duration_ms AS duration_ms,
  e.ts AS ended_at,
  e.listened_ms AS listened_ms,
  e.end_reason AS end_reason,
  CASE WHEN e.listened_ms IS NOT NULL
        AND e.listened_ms >= MIN(30000, COALESCE(NULLIF(s.duration_ms, 0), 60000) / 2)
       THEN 1 ELSE 0 END AS counted,
  CASE WHEN e.end_reason IN ('SKIP_NEXT', 'SKIP_PREV') AND e.listened_ms < 30000
       THEN 1 ELSE 0 END AS skipped
FROM playback_event s
LEFT JOIN playback_event e ON e.listen_id = s.listen_id AND e.event_type = 'END'
WHERE s.event_type = 'START';

insertEvent:
INSERT INTO playback_event(
  ts, tz_offset_min, event_type, listen_id, track_id, duration_ms, position_ms, seek_to_ms, listened_ms,
  start_reason, end_reason, context_type, context_id, output_device_type, output_device_name,
  shuffle, repeat_mode, speed
) VALUES (
  :ts, :tzOffsetMin, :eventType, :listenId, :trackId, :durationMs, :positionMs, :seekToMs, :listenedMs,
  :startReason, :endReason, :contextType, :contextId, :outputDeviceType, :outputDeviceName,
  :shuffle, :repeatMode, :speed
);

-- Privacy controls: the user owns this data.
deleteAllEvents:
DELETE FROM playback_event;

deleteEventsBefore:
DELETE FROM playback_event WHERE ts < :ts;

exportEvents:
SELECT * FROM playback_event ORDER BY id;
