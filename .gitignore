# =============================================================================
# PROJECT UNBOUND - Git Ignore Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Local JDK & SDK
# -----------------------------------------------------------------------------
jdk*/
**/jdk*/
local.properties
**/local.properties
*.hprof

# -----------------------------------------------------------------------------
# Rust Build Artifacts
# -----------------------------------------------------------------------------
target/
**/target/
**/*.rs.bk

# -----------------------------------------------------------------------------
# Gradle & Kotlin Build Artifacts
# -----------------------------------------------------------------------------
build/
**/build/
.gradle/
**/.gradle/
.kotlin/
**/.kotlin/
*.class
# Preserve Gradle wrapper jar
!gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.jar

# -----------------------------------------------------------------------------
# Native Binaries & Build Objects
# -----------------------------------------------------------------------------
*.dll
*.dll.*
*.so
*.so.*
*.dylib
*.dylib.*
*.exe
*.lib
*.pdb
*.exp
*.ilk
*.obj
*.o
*.a
*.d
*.timestamp
*.rlib
*.rmeta
cmake-build-*/
.cxx/
**/.cxx/

# -----------------------------------------------------------------------------
# Python Environments & Bytecode (AI Spike, tooling)
# -----------------------------------------------------------------------------
.venv/
**/.venv/
venv/
**/venv/
env/
**/env/
ENV/
**/ENV/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
**/.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
dist/

# -----------------------------------------------------------------------------
# AI / ML Models, Weights, Embeddings & Large Checkpoints (>100MB / non-code)
# -----------------------------------------------------------------------------
*.onnx
*.onnx.data
*.ort
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.h5
*.pb
*.tflite
*.weights
*.npz
*.npy
*.pkl
*.pickle
models/
**/models/

# -----------------------------------------------------------------------------
# Audio & Media Byproducts (Test Music, Sample Tracks, Separated Stems)
# -----------------------------------------------------------------------------
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.aac
*.wma
*.aiff
*.alac
*.opus
*.mid
*.midi
*.mp4
*.mkv
*.avi
*.mov

# AI Spike output datasets & stem generations
ai-spike/data/
**/ai-spike/data/
ai-spike/out/
**/ai-spike/out/
ai-spike/models/
**/ai-spike/models/
stems/
**/stems/
out/
**/out/
# Preserve JSON fixtures for rust crate
!**/autoplay-rs/data/**

# -----------------------------------------------------------------------------
# SQLite / Database Files & Journals (Phase 2 Data Layer)
# -----------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# -----------------------------------------------------------------------------
# Archives & Compressed Backups
# -----------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.gz
*.bz2
# Preserve reference material in Sources/ if needed
!Sources/*.zip

# -----------------------------------------------------------------------------
# Logs, Benchmark Outputs & Test Execution Byproducts
# -----------------------------------------------------------------------------
*.log
**/*.log
logs/
**/logs/
reports/
**/reports/
test-results/
**/test-results/

# -----------------------------------------------------------------------------
# IDE & System Files
# -----------------------------------------------------------------------------
.idea/
**/.idea/
.vscode/
**/.vscode/
.DS_Store
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
*.swp
*.swo
*~
*.tmp
*.bak
scratch/
