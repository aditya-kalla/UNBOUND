-- ============================================================================
-- UNBOUND library schema (SQLite via SQLDelight). Schema version 1.
-- Rules: never edit a shipped table in place -> add a migration (N.sqm).
-- Tracks are SOFT-deleted (is_missing) so likes/playlists/history survive a
-- drive being unplugged or a file being moved.
-- ============================================================================

CREATE TABLE artwork (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  content_hash TEXT NOT NULL UNIQUE,      -- dedupes the same cover across a whole album
  cache_path TEXT NOT NULL,
  width INTEGER NOT NULL DEFAULT 0,
  height INTEGER NOT NULL DEFAULT 0,
  dominant_color INTEGER,                 -- ARGB, filled lazily (Phase 5 theming)
  accent_color INTEGER
);

CREATE TABLE scan_source (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  uri TEXT NOT NULL UNIQUE,               -- folder path / SAF tree uri / 'mediastore:'
  kind TEXT NOT NULL,                     -- FOLDER | MEDIASTORE
  display_name TEXT NOT NULL,
  enabled INTEGER NOT NULL DEFAULT 1,
  last_scan_at INTEGER
);

CREATE TABLE artist (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,
  name_sort TEXT NOT NULL,                -- lowercase, leading article stripped
  name_key TEXT NOT NULL UNIQUE           -- lowercase, whitespace-collapsed identity key
);

CREATE TABLE album (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  title TEXT NOT NULL,
  title_sort TEXT NOT NULL,
  album_artist_id INTEGER REFERENCES artist(id) ON DELETE SET NULL,
  album_artist_display TEXT NOT NULL DEFAULT '',
  year INTEGER,
  artwork_id INTEGER REFERENCES artwork(id) ON DELETE SET NULL,
  album_key TEXT NOT NULL UNIQUE          -- title_key|album_artist_key
);

CREATE TABLE track (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  source_id INTEGER REFERENCES scan_source(id) ON DELETE SET NULL,
  uri TEXT NOT NULL UNIQUE,
  file_size INTEGER NOT NULL DEFAULT 0,
  file_mtime INTEGER NOT NULL DEFAULT 0,
  fingerprint TEXT,                       -- size + head/tail hash: detects moved/renamed files
  title TEXT NOT NULL,
  title_sort TEXT NOT NULL,
  artist_display TEXT NOT NULL DEFAULT '',
  album_id INTEGER REFERENCES album(id) ON DELETE SET NULL,
  track_no INTEGER,
  disc_no INTEGER,
  year INTEGER,
  duration_ms INTEGER NOT NULL DEFAULT 0,
  bitrate_kbps INTEGER,
  sample_rate INTEGER,
  channels INTEGER,
  bit_depth INTEGER,
  codec TEXT,
  is_lossless INTEGER NOT NULL DEFAULT 0,
  rg_track_gain_db REAL,
  rg_track_peak REAL,
  rg_album_gain_db REAL,
  rg_album_peak REAL,
  loudness_lufs REAL,                     -- filled by the analyzer when no ReplayGain tags
  true_peak_db REAL,
  analysis_version INTEGER NOT NULL DEFAULT 0,
  has_embedded_lyrics INTEGER NOT NULL DEFAULT 0,
  lrc_uri TEXT,                           -- sidecar .lrc next to the audio file
  artwork_id INTEGER REFERENCES artwork(id) ON DELETE SET NULL,
  added_at INTEGER NOT NULL,
  scanned_at INTEGER NOT NULL,
  meta_version INTEGER NOT NULL DEFAULT 1,-- bump reader version => rescan picks up new fields
  is_missing INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX track_title_sort ON track(title_sort);
CREATE INDEX track_album ON track(album_id, disc_no, track_no);
CREATE INDEX track_source ON track(source_id);
CREATE INDEX track_added ON track(added_at);
CREATE INDEX track_fingerprint ON track(fingerprint);

CREATE TABLE track_artist (
  track_id INTEGER NOT NULL REFERENCES track(id) ON DELETE CASCADE,
  artist_id INTEGER NOT NULL REFERENCES artist(id) ON DELETE CASCADE,
  role TEXT NOT NULL DEFAULT 'MAIN',      -- MAIN | FEATURED
  position INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (track_id, artist_id, role)
);
CREATE INDEX track_artist_by_artist ON track_artist(artist_id);

CREATE TABLE track_genre (
  track_id INTEGER NOT NULL REFERENCES track(id) ON DELETE CASCADE,
  genre TEXT NOT NULL,
  PRIMARY KEY (track_id, genre)
);
CREATE INDEX track_genre_by_genre ON track_genre(genre);

-- Full-text search. rowid == track.id. Maintained explicitly by the repository inside the
-- same transaction as the track upsert. Needs FTS5 (see architecture doc: LIKE fallback).
CREATE VIRTUAL TABLE track_search USING fts5(
  title, artists, album, genres,
  tokenize = "unicode61 remove_diacritics 2",
  prefix = "2 3"
);

-- ---------------------------------------------------------------- scan support
selectScanIndex:
SELECT id, uri, file_size, file_mtime, fingerprint, is_missing, meta_version
FROM track WHERE source_id = :sourceId;

upsertTrack:
INSERT INTO track (
  source_id, uri, file_size, file_mtime, fingerprint, title, title_sort, artist_display,
  album_id, track_no, disc_no, year, duration_ms, bitrate_kbps, sample_rate, channels, bit_depth,
  codec, is_lossless, rg_track_gain_db, rg_track_peak, rg_album_gain_db, rg_album_peak,
  has_embedded_lyrics, lrc_uri, artwork_id, added_at, scanned_at, meta_version, is_missing
) VALUES (
  :sourceId, :uri, :fileSize, :fileMtime, :fingerprint, :title, :titleSort, :artistDisplay,
  :albumId, :trackNo, :discNo, :year, :durationMs, :bitrateKbps, :sampleRate, :channels, :bitDepth,
  :codec, :isLossless, :rgTrackGain, :rgTrackPeak, :rgAlbumGain, :rgAlbumPeak,
  :hasLyrics, :lrcUri, :artworkId, :now, :now, :metaVersion, 0
)
ON CONFLICT(uri) DO UPDATE SET
  source_id = excluded.source_id, file_size = excluded.file_size, file_mtime = excluded.file_mtime,
  fingerprint = excluded.fingerprint, title = excluded.title, title_sort = excluded.title_sort,
  artist_display = excluded.artist_display, album_id = excluded.album_id, track_no = excluded.track_no,
  disc_no = excluded.disc_no, year = excluded.year, duration_ms = excluded.duration_ms,
  bitrate_kbps = excluded.bitrate_kbps, sample_rate = excluded.sample_rate, channels = excluded.channels,
  bit_depth = excluded.bit_depth, codec = excluded.codec, is_lossless = excluded.is_lossless,
  rg_track_gain_db = excluded.rg_track_gain_db, rg_track_peak = excluded.rg_track_peak,
  rg_album_gain_db = excluded.rg_album_gain_db, rg_album_peak = excluded.rg_album_peak,
  has_embedded_lyrics = excluded.has_embedded_lyrics, lrc_uri = excluded.lrc_uri,
  artwork_id = excluded.artwork_id, scanned_at = excluded.scanned_at,
  meta_version = excluded.meta_version, is_missing = 0;

selectTrackIdByUri:
SELECT id FROM track WHERE uri = :uri;

-- A moved/renamed file keeps its identity (likes, playlists, play history).
relinkTrack:
UPDATE track SET uri = :uri, source_id = :sourceId, file_mtime = :fileMtime, file_size = :fileSize,
  scanned_at = :now, is_missing = 0 WHERE id = :id;

markMissing:
UPDATE track SET is_missing = 1 WHERE id = :id;

deleteTrackArtists:
DELETE FROM track_artist WHERE track_id = :trackId;

deleteTrackGenres:
DELETE FROM track_genre WHERE track_id = :trackId;

insertTrackArtist:
INSERT OR IGNORE INTO track_artist(track_id, artist_id, role, position) VALUES (:trackId, :artistId, :role, :position);

insertTrackGenre:
INSERT OR IGNORE INTO track_genre(track_id, genre) VALUES (:trackId, :genre);

insertArtistIgnore:
INSERT OR IGNORE INTO artist(name, name_sort, name_key) VALUES (:name, :nameSort, :nameKey);

selectArtistIdByKey:
SELECT id FROM artist WHERE name_key = :nameKey;

insertAlbumIgnore:
INSERT OR IGNORE INTO album(title, title_sort, album_artist_id, album_artist_display, year, artwork_id, album_key)
VALUES (:title, :titleSort, :albumArtistId, :albumArtistDisplay, :year, :artworkId, :albumKey);

selectAlbumIdByKey:
SELECT id FROM album WHERE album_key = :albumKey;

insertArtworkIgnore:
INSERT OR IGNORE INTO artwork(content_hash, cache_path, width, height) VALUES (:hash, :path, :width, :height);

selectArtworkIdByHash:
SELECT id FROM artwork WHERE content_hash = :hash;

-- search index maintenance
deleteSearchRow:
DELETE FROM track_search WHERE rowid = :trackId;

insertSearchRow:
INSERT INTO track_search(rowid, title, artists, album, genres) VALUES (:trackId, :title, :artists, :album, :genres);

-- housekeeping after a scan
pruneEmptyAlbums:
DELETE FROM album WHERE id NOT IN (SELECT DISTINCT album_id FROM track WHERE album_id IS NOT NULL);

pruneEmptyArtists:
DELETE FROM artist WHERE id NOT IN (SELECT artist_id FROM track_artist)
  AND id NOT IN (SELECT album_artist_id FROM album WHERE album_artist_id IS NOT NULL);

pruneUnusedArtwork:
DELETE FROM artwork WHERE id NOT IN (SELECT artwork_id FROM track WHERE artwork_id IS NOT NULL)
  AND id NOT IN (SELECT artwork_id FROM album WHERE artwork_id IS NOT NULL);

-- ---------------------------------------------------------------- reads (examples; Prompt 1 adds the rest)
trackById:
SELECT * FROM track WHERE id = :id;

tracksByTitle:
SELECT id, title, artist_display, album_id, duration_ms, artwork_id, uri, is_missing
FROM track WHERE is_missing = 0 ORDER BY title_sort, id;

searchFts:
SELECT rowid AS track_id FROM track_search WHERE track_search MATCH :ftsQuery ORDER BY rank LIMIT :limit;

searchLike:
SELECT id AS track_id FROM track
WHERE is_missing = 0 AND (title LIKE '%' || :q || '%' OR artist_display LIKE '%' || :q || '%')
ORDER BY title_sort LIMIT :limit;

sourceList:
SELECT * FROM scan_source ORDER BY id;

insertSource:
INSERT OR IGNORE INTO scan_source(uri, kind, display_name) VALUES (:uri, :kind, :displayName);

touchSource:
UPDATE scan_source SET last_scan_at = :at WHERE id = :id;
