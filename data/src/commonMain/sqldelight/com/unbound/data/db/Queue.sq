-- Persistent queue. `position` = CURRENT play order (already shuffled if shuffle is on);
-- `original_position` = order before shuffling, so turning shuffle off restores it.
CREATE TABLE queue_item (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  track_id INTEGER NOT NULL REFERENCES track(id) ON DELETE CASCADE,
  position INTEGER NOT NULL,
  original_position INTEGER NOT NULL,
  origin TEXT NOT NULL DEFAULT 'CONTEXT'   -- CONTEXT | USER (play-next/add-to-queue) | AUTOPLAY
);
CREATE INDEX queue_item_position ON queue_item(position);

CREATE TABLE player_state (
  id INTEGER PRIMARY KEY CHECK (id = 1),
  current_item_id INTEGER,
  position_ms INTEGER NOT NULL DEFAULT 0,
  shuffle INTEGER NOT NULL DEFAULT 0,
  repeat_mode TEXT NOT NULL DEFAULT 'OFF',  -- OFF | ALL | ONE
  speed REAL NOT NULL DEFAULT 1.0,
  context_type TEXT,
  context_id TEXT,
  updated_at INTEGER NOT NULL DEFAULT 0
);

initPlayerState:
INSERT OR IGNORE INTO player_state(id, updated_at) VALUES (1, 0);

selectPlayerState:
SELECT * FROM player_state WHERE id = 1;

savePlayerState:
UPDATE player_state SET current_item_id = :currentItemId, position_ms = :positionMs, shuffle = :shuffle,
  repeat_mode = :repeatMode, speed = :speed, context_type = :contextType, context_id = :contextId, updated_at = :now
WHERE id = 1;

queueRows:
SELECT q.id AS item_id, q.position, q.original_position, q.origin,
       t.id AS track_id, t.title, t.artist_display, t.duration_ms, t.artwork_id, t.uri, t.is_missing
FROM queue_item q JOIN track t ON t.id = q.track_id ORDER BY q.position, q.id;

clearQueue:
DELETE FROM queue_item;

insertQueueItem:
INSERT INTO queue_item(track_id, position, original_position, origin) VALUES (:trackId, :position, :originalPosition, :origin);

setQueuePosition:
UPDATE queue_item SET position = :position WHERE id = :id;

deleteQueueItem:
DELETE FROM queue_item WHERE id = :id;

maxQueuePosition:
SELECT MAX(position) FROM queue_item;

-- Same rule as playlists: read ids in order, rewrite positions in one transaction.
queueItemIdsOrdered:
SELECT id FROM queue_item ORDER BY position, id;
